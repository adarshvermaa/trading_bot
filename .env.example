# ==============================================================================
# Delta Exchange India API Credentials (https://india.delta.exchange)
# NEVER commit your actual API keys or secrets to version control.
# ==============================================================================
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_API_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# ==============================================================================
# Jev AI (System One) Cognitive Model & Advisory
# ==============================================================================
JEV_API_KEY=your_jev_api_key_here

# Optional LiteLLM Integration (e.g., gpt-4o-mini, claude-3-5-sonnet)
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini

# ==============================================================================
# Trading Execution Safety Mode
# Set to "true" ONLY when ready to execute real orders with real funds.
# Leave "false" for safe paper simulation.
# ==============================================================================
LIVE_TRADING=false

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
